1 4 -40 -104 20 0 0 1 0 1 0 -1 0 0 3001.dat
0 STEP
0 // Step 5: 四角立起蓝色 2x2 柱（2 层）
1 1 40 -128 40 1 0 0 0 1 0 0 0 1 3003.dat
