0 STEP
0 // Step 3: 盖上灰色 8x8 平台，桥接 4 条腿
1 71 0 -72 0 1 0 0 0 1 0 0 0 1 41539.dat
0 STEP
0 // Step 4: 平台上叠红色风车圈（2 层）收窄塔身
1 4 -20 -80 -40 1 0 0 0 1 0 0 0 1 3001.dat
1 4 40 -80 -20 0 0 1 0 1 0 -1 0 0 3001.dat
