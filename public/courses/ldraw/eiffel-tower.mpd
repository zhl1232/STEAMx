0 // Step 6: 盖上第二块灰色平台
1 71 0 -176 0 1 0 0 0 1 0 0 0 1 41539.dat
0 STEP
0 // Step 7: 叠蓝色风车圈（2 层）
1 1 -20 -184 -40 1 0 0 0 1 0 0 0 1 3001.dat
