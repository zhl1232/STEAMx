{
  "name": "steam-explore-share",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "dev:turbo": "next dev --turbo",
    "dev:webpack": "next dev --webpack",
    "dev:clean": "rm -rf .next/dev && next dev --turbo",
    "build:scratch": "pnpm --filter scratch-host build && pnpm --filter scratch-host run copy-to-public",
    "dev:scratch": "pnpm --filter scratch-host dev",
    "build": "pnpm run build:scratch && next build",
    "start": "next start",
    "lint": "oxlint --react-plugin --nextjs-plugin app components hooks lib packages/scratch-host/src *.config.* *.ts *.tsx",
    "lint:fix": "oxlint --fix --react-plugin --nextjs-plugin app components hooks lib packages/scratch-host/src *.config.* *.ts *.tsx",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:related": "vitest related --run --passWithNoTests",
    "push": "git push && node scripts/ci-watch.mjs",
    "ci:watch": "node scripts/ci-watch.mjs",
    "ci:status": "node scripts/ci-watch.mjs --once",
    "test:watch": "vitest",
    "eval:tutor": "TUTOR_GOLDEN_SET=1 vitest run __tests__/tutor-golden-set.eval.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:integration": "playwright test -c playwright.integration.config.ts",
    "test:e2e:scratch": "playwright test -c playwright.scratch-host.config.ts",
    "prepare": "husky",
    "compress:images": "node scripts/compress-project-images.mjs",
    "compress:fruit-images": "COMPRESS_IMAGES_DIR=public/fruits/images COMPRESS_MAX_SIDE=1280 COMPRESS_JPEG_QUALITY=80 node scripts/compress-project-images.mjs",
    "birds:fetch-media": "node scripts/fetch-bird-media-from-wikimedia.mjs",
    "birds:sync-media-db": "node scripts/sync-bird-media-to-db.mjs",
    "db:push": "node scripts/db-push.mjs push",
    "db:status": "node scripts/db-push.mjs status",
    "db:baseline": "node scripts/db-push.mjs baseline",
    "db:course-config": "node scripts/course-config-preflight.mjs"
  },
  "dependencies": {
    "@alicloud/dypnsapi20170525": "^2.0.0",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/tea-util": "^1.4.11",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slider": "^1.4.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toast": "^1.2.19",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.5",
    "browser-image-compression": "^2.0.2",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "framer-motion": "^12.42.2",
    "leaflet": "1.9.4",
    "lucide-react": "^1.24.0",
    "modern-screenshot": "^4.7.0",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "pinyin-pro": "^3.28.1",
    "postgres": "^3.4.9",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.185.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "1.9.21",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@types/ws": "^8.18.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "ali-oss": "^6.23.0",
    "baseline-browser-mapping": "^2.10.42",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "oxlint": "^1.73.0",
    "postcss": "^8.5.16",
    "sharp": "^0.35.3",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.22.0"
}
