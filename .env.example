# Supabase 配置
# 从 Supabase Dashboard 获取这些值: https://app.supabase.com/project/_/settings/api

# Supabase 项目 URL
NEXT_PUBLIC_SUPABASE_URL=your-project-url

# Supabase 匿名公钥 (Anon Key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 注意：应用启动时会严格校验以上两个变量；
# 本地开发、CI 与 Cloudflare Worker 都需要提供。

# Service Role Key（用于 pnpm db:push 执行迁移，不要提交）
# 在 Dashboard → Settings → API → service_role key 中找到
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 可选配置
# NEXT_PUBLIC_APP_URL=https://steam.bj.cn
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SEO / 站长平台（可选；勿把真实 token 提交进仓库）
# Google Search Console HTML meta 验证码 → 根布局 metadata.verification.google
# GOOGLE_SITE_VERIFICATION=
# 百度搜索资源平台 HTML meta 验证码 → metadata.verification.other["baidu-site-verification"]
# （文件验证也可继续用 public/baidu_verify_*.html）
# BAIDU_SITE_VERIFICATION=
# Bing Webmaster Tools meta verification token (optional)
# BING_SITE_VERIFICATION=
# 百度主动推送：生产 Release 读取 GitHub secret BAIDU_PUSH_TOKEN；本地可 pnpm seo:baidu-push
# 推送站点必须是规范主域 https://steam.bj.cn（脚本默认值，勿改成 steamx.cc）
# BAIDU_PUSH_TOKEN=
# BAIDU_PUSH_SITE=https://steam.bj.cn
# 站内问题反馈默认发给该管理员账号；不配置时按最早创建的 admin 账号兜底
# SUPPORT_USER_ID=
# 备用反馈渠道，未配置时对应入口不显示
# NEXT_PUBLIC_SUPPORT_EMAIL=
# NEXT_PUBLIC_SUPPORT_WECHAT=
# 本地开发如通过内网 IP/手机访问 Next dev server，按需追加，例如：
# NEXT_ALLOWED_DEV_ORIGINS=10.32.10.214,192.168.1.23

# 外部请求连接/响应超时，避免 DNS 或上游故障时请求长期占用内存
# SUPABASE_FETCH_TIMEOUT_MS=12000
# ASSET_CONNECT_TIMEOUT_MS=10000

# 阿里云 OSS 静态资源基地址（物种图、项目图、Scratch 素材库等）
# 配置后生产环境 /internalapi/asset/* 会 rewrite 到 OSS；图片封装在各环境都会先解析到同一资源域名
# 本地开发默认经 /api/assets 代理（含 Scratch 素材 /internalapi/asset/*）并带生产 Referer 拉取 OSS，用于模拟线上防盗链；如需直连 CDN 排查，可设置 direct
# NEXT_PUBLIC_ASSETS_BASE_URL=https://assets.example.com
# NEXT_PUBLIC_ASSETS_DISPLAY_MODE=direct
# 视频 /api/assets 短时 HMAC（.mp4/.webm 强制验签；未配置则不校验，便于本地）
# ASSETS_URL_SIGNING_SECRET=
# ASSETS_URL_SIGNING_TTL_SECONDS=1200
# ALIYUN_OSS_ACCESS_KEY_ID=
# ALIYUN_OSS_ACCESS_KEY_SECRET=
# ALIYUN_OSS_BUCKET=
# ALIYUN_OSS_REGION=oss-cn-hangzhou

# 手机认证：默认 legacy，保留现有短信服务；在 Supabase Phone 配置完成、账号核验后切换
# AUTH_PHONE_PROVIDER=legacy
# 原生模式的短信密钥/签名/模板配置在 Supabase Auth 后台，不放入 NEXT_PUBLIC_*。
# 配置与切换步骤见 docs/phone-auth.md。
# 旧短信验证码（legacy 模式）
# 配置下面两个即走阿里云普通短信 SendSms：北京创探科技 / SMS_332130837 / code
# 生产密钥在服务器 /opt/steam-app/.env.production 配置，本地文件不会自动同步
# SMS_ALIYUN_ACCESS_KEY_ID=
# SMS_ALIYUN_ACCESS_KEY_SECRET=
# 自定义 HTTP 发短信（未配阿里云且需发短信时）：SMS_PROVIDER=custom、SMS_CUSTOM_URL=

# DashScope 视觉识别（自然观察图片识别）
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型自动切换：先读取 /models 中可见的候选，遇到额度耗尽/限流/模型不可用时进入冷却并切下一个
# 默认开启；设为 false 时退回各角色的单模型环境变量
# DASHSCOPE_MODEL_AUTO_SWITCH=true
# 模型目录缓存 5 分钟；设为 false 时仅使用下方静态候选，不请求 /models
# DASHSCOPE_MODEL_DISCOVERY=true
# 小迪主对话优先 qwen3.8-max；逗号分隔，前面的优先级更高
# DASHSCOPE_TUTOR_TEXT_MODELS=qwen3.8-max,qwen3.7-max,qwen3.7-plus,qwen3.7-flash
# 内部规划默认使用较快模型，失败时再回退到其它文本模型
# DASHSCOPE_TUTOR_PLANNER_MODELS=qwen-flash,qwen3.7-flash,qwen3.7-plus
# 图像、审核、语音也支持各自的候选列表：
# DASHSCOPE_TUTOR_VISION_MODELS=qwen3.7-plus,qwen3-vl-flash
# DASHSCOPE_MODERATION_MODELS=qwen3-vl-flash,qwen3.7-plus
# DASHSCOPE_TUTOR_TTS_MODELS=qwen3-tts-flash,qwen3-tts-flash-2025-11-27
# DASHSCOPE_TUTOR_TTS_REALTIME_MODELS=qwen3-tts-flash-realtime,qwen3-tts-flash-realtime-2025-11-27
# DASHSCOPE_TUTOR_ASR_MODELS=qwen3-asr-flash-realtime,qwen3-asr-flash-realtime-2025-10-27
# DASHSCOPE_VISION_MODEL=qwen3.7-plus
# 图片安全审核（上传/作品配图）默认 qwen3-vl-flash；未设置时回退 DASHSCOPE_VISION_MODEL
# DASHSCOPE_MODERATION_MODEL=qwen3-vl-flash
# 小迪语音输入/朗读（复用 DASHSCOPE_API_KEY）
# Qwen-ASR Realtime 建议配置为阿里云百炼业务空间专属 WebSocket 地址：
# wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
# 未配置时使用旧版公共域名兜底。
# DASHSCOPE_TUTOR_ASR_WS_URL=wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
# DASHSCOPE_TUTOR_ASR_MODEL=qwen3-asr-flash-realtime
# DASHSCOPE_TUTOR_TTS_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# DASHSCOPE_TUTOR_TTS_MODEL=qwen3-tts-flash
# DASHSCOPE_TUTOR_TTS_VOICE=Ethan
# DASHSCOPE_TUTOR_TTS_LANGUAGE=Chinese
# 自动互动（仅点赞/收藏，不生成评论）
# AUTO_INTERACTION_ENABLED=true
# AUTO_INTERACTION_MIN_DELAY_MINUTES=2
# AUTO_INTERACTION_MAX_DELAY_MINUTES=90
# AUTO_INTERACTION_WORKER_INTERVAL_SECONDS=300
# AUTO_INTERACTION_WORKER_LIMIT=20
# AUTO_INTERACTION_BACKFILL_ON_START=false
# AUTO_INTERACTION_BACKFILL_DRY_RUN=false
# AUTO_INTERACTION_BACKFILL_LIMIT=100
# AUTO_INTERACTION_BACKFILL_SCAN_LIMIT=1000
# AUTO_INTERACTION_BACKFILL_SAMPLE_RATE=0.25
# AUTO_INTERACTION_BACKFILL_LIKE_RATE=0.5
# AUTO_INTERACTION_BACKFILL_COLLECTION_RATE=0.2
# DASHSCOPE_TEXT_MODEL=qwen3.7-plus

# 内部 Worker/Cron 鉴权
# CRON_SECRET=
# INTERNAL_API_SECRET=

# 实物商城与 1688 代发（均只在服务端使用，勿提交真实凭证）
# ALIBABA_1688_APP_KEY=
# ALIBABA_1688_APP_SECRET=
# ALIBABA_1688_REDIRECT_URI=https://your-domain.example/api/store/alibaba/oauth/callback
# ALIBABA_1688_SCOPE=        # 按 1688 应用审核通过的 scope 填写
# ALIBABA_1688_API_ORIGIN=https://gw.open.1688.com
# ALIBABA_1688_TIMEOUT_MS=15000
# ALIBABA_1688_ORDER_API=alibaba.trade.fastCreateOrder
# STORE_ADDRESS_ENCRYPTION_KEY=         # 32 字节 base64 或 64 位 hex
# STORE_ALIBABA_TOKEN_ENCRYPTION_KEY=   # 32 字节 base64 或 64 位 hex

# 高德 Web 服务 Key（自然观察地图逆地理编码，不要使用浏览器端 Key）
# AMAP_WEB_SERVICE_KEY=

# Platform announcement delivery worker (shares CRON_SECRET / INTERNAL_API_SECRET above)
# COMMUNICATIONS_WORKER_INTERVAL_SECONDS=60
# COMMUNICATIONS_WORKER_LIMIT=50

# 本站实物商城：默认关闭，审核和真实小额验收前不要打开
STORE_CATALOG_ENABLED=false
STORE_CHECKOUT_ENABLED=false
STORE_PAYMENTS_ENABLED=false
STORE_ALIPAY_ENABLED=false
STORE_WECHAT_ENABLED=false
STORE_ADMIN_PREVIEW_ENABLED=false
STORE_ALIBABA_AUTOMATION_ENABLED=false
# test 强制支付宝沙箱；微信 test 不允许真实网络，使用本地协议测试夹具
# 管理员结算预览还要求非 production + 本地 NEXT_PUBLIC_SUPABASE_URL
# STORE_ENVIRONMENT=test
# STORE_PAYMENT_ORIGIN=https://your-domain.example
# 仅配置由可信反向代理覆盖、客户端不能伪造的单一真实 IP 请求头；H5 必需
# STORE_TRUSTED_CLIENT_IP_HEADER=x-real-ip
# ALIPAY_APP_ID=
# ALIPAY_SELLER_ID=
# ALIPAY_PRIVATE_KEY=                 # 完整 PEM，支持换行或字面量 \n
# ALIPAY_PUBLIC_KEY=                  # 支付宝平台公钥 PEM
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_MERCHANT_SERIAL=          # 商户 API 证书序列号（请求签名）
# WECHAT_PAY_PRIVATE_KEY=              # 商户 API 私钥 PEM
# WECHAT_PAY_API_V3_KEY=               # 恰好 32 字节的 APIv3 UTF-8 密钥
# WECHAT_PAY_PUBLIC_KEY_ID=            # PUB_KEY_ID_...（响应和回调验签）
# WECHAT_PAY_PUBLIC_KEY=               # 微信支付平台公钥 PEM
# 每分钟由服务端 POST /api/internal/store/reconcile，Authorization: Bearer CRON_SECRET
# 默认不配置任何支付凭证；旧 STORE_PAYMENT_WEBHOOK_SECRET 已停用
