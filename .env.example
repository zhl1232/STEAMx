# Supabase 配置
# 从 Supabase Dashboard 获取这些值: https://app.supabase.com/project/_/settings/api

# Supabase 项目 URL
NEXT_PUBLIC_SUPABASE_URL=your-project-url

# Supabase 匿名公钥 (Anon Key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 注意：应用启动时会严格校验以上两个变量；
# 本地开发、CI 与 Cloudflare Worker 都需要提供。

# Service Role Key（用于 pnpm db:push 执行迁移，不要提交）
# 在 Dashboard → Settings → API → service_role key 中找到
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 可选配置
# NEXT_PUBLIC_APP_URL=https://www.steamx.cc
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 本地开发如通过内网 IP/手机访问 Next dev server，按需追加，例如：
# NEXT_ALLOWED_DEV_ORIGINS=10.32.10.214,192.168.1.23

# 外部请求连接/响应超时，避免 DNS 或上游故障时请求长期占用内存
# SUPABASE_FETCH_TIMEOUT_MS=12000
# ASSET_CONNECT_TIMEOUT_MS=10000

# 阿里云 OSS 静态资源基地址（物种图、项目图、Scratch 素材库等）
# 配置后生产环境 /internalapi/asset/* 会 rewrite 到 OSS；图片封装在各环境都会先解析到同一资源域名
# 本地开发默认经 /api/assets 代理（含 Scratch 素材 /internalapi/asset/*）并带生产 Referer 拉取 OSS，用于模拟线上防盗链；如需直连 CDN 排查，可设置 direct
# NEXT_PUBLIC_ASSETS_BASE_URL=https://assets.example.com
# NEXT_PUBLIC_ASSETS_DISPLAY_MODE=direct
# ALIYUN_OSS_ACCESS_KEY_ID=
# ALIYUN_OSS_ACCESS_KEY_SECRET=
# ALIYUN_OSS_BUCKET=
# ALIYUN_OSS_REGION=oss-cn-hangzhou

# 短信验证码（可选）
# 配置下面两个即走阿里云，签名/模板在代码内写死
# SMS_ALIYUN_ACCESS_KEY_ID=
# SMS_ALIYUN_ACCESS_KEY_SECRET=
# 自定义 HTTP 发短信（未配阿里云且需发短信时）：SMS_PROVIDER=custom、SMS_CUSTOM_URL=

# DashScope 视觉识别（自然观察图片识别）
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_VISION_MODEL=qwen3.7-plus
# 小迪语音输入/朗读（复用 DASHSCOPE_API_KEY）
# Qwen-ASR Realtime 建议配置为阿里云百炼业务空间专属 WebSocket 地址：
# wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
# 未配置时使用旧版公共域名兜底。
# DASHSCOPE_TUTOR_ASR_WS_URL=wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
# DASHSCOPE_TUTOR_ASR_MODEL=qwen3-asr-flash-realtime
# DASHSCOPE_TUTOR_TTS_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# DASHSCOPE_TUTOR_TTS_MODEL=qwen3-tts-flash
# DASHSCOPE_TUTOR_TTS_VOICE=Ethan
# DASHSCOPE_TUTOR_TTS_LANGUAGE=Chinese
# 自动互动（短回复/点赞/收藏），复用 DashScope 兼容 Chat Completions
# AUTO_INTERACTION_ENABLED=true
# AUTO_REPLY_RATE=0.8
# AUTO_INTERACTION_MIN_DELAY_MINUTES=2
# AUTO_INTERACTION_MAX_DELAY_MINUTES=90
# AUTO_INTERACTION_WORKER_INTERVAL_SECONDS=300
# AUTO_INTERACTION_WORKER_LIMIT=20
# AUTO_INTERACTION_BACKFILL_ON_START=false
# AUTO_INTERACTION_BACKFILL_DRY_RUN=false
# AUTO_INTERACTION_BACKFILL_LIMIT=100
# AUTO_INTERACTION_BACKFILL_SCAN_LIMIT=1000
# AUTO_INTERACTION_BACKFILL_SAMPLE_RATE=0.25
# AUTO_INTERACTION_BACKFILL_REPLY_RATE=0.35
# AUTO_INTERACTION_BACKFILL_LIKE_RATE=0.5
# AUTO_INTERACTION_BACKFILL_COLLECTION_RATE=0.2
# DASHSCOPE_TEXT_MODEL=qwen3.7-plus

# 内部 Worker/Cron 鉴权
# CRON_SECRET=
# INTERNAL_API_SECRET=

# 高德 Web 服务 Key（自然观察地图逆地理编码，不要使用浏览器端 Key）
# AMAP_WEB_SERVICE_KEY=
